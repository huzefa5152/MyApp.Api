<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- scripts/ and tools/ contain standalone dev tools (PdfDumper, ManagerImport)
       that must not be compiled into the main web API assembly — each has its
       own .csproj. -->
  <ItemGroup>
    <Compile Remove="scripts/**/*.cs" />
    <!-- Built-in print templates, generated from myapp-frontend/src/utils/defaultTemplates.js
         by scripts/sync_default_print_templates.mjs (see Helpers/DefaultPrintTemplates.cs). -->
    <EmbeddedResource Include="Data/DefaultPrintTemplates/*.html" />
    <!-- The branch -> local-database map is developer tooling, read from the
         REPO ROOT (next to .git) and only in Development. Keeping it out of
         the publish output means a deploy cannot carry a local connection
         string at all, belt and braces with the two runtime conditions in
         Helpers/LocalDevDatabase.cs. -->
    <Content Remove="local.databases.json" />
    <Content Remove="local.databases.local.json" />
    <None Remove="local.databases.json" />
    <None Remove="local.databases.local.json" />
    <Content Remove="production.databases*.json" />
    <None Remove="production.databases*.json" />

    <Content Remove="scripts/**/*" />
    <None Remove="scripts/**/*" />
    <EmbeddedResource Remove="scripts/**/*" />
    <Compile Remove="tools/**/*.cs" />
    <Content Remove="tools/**/*" />
    <None Remove="tools/**/*" />
    <EmbeddedResource Remove="tools/**/*" />
    <!-- tests/ holds the xUnit test project (MyApp.Api.Tests, audit C-2). It
         has its own .csproj and must never be globbed into the web assembly.
         It matters even when the suite is not checked out on THIS branch:
         only the root obj/ and bin/ are excluded by DefaultItemExcludes, so a
         leftover tests/**/obj/**/*.AssemblyInfo.cs from another branch's build
         gets swallowed by the default **/*.cs glob and the build dies with
         8 x CS0579 duplicate assembly attributes. -->
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
    <None Remove="tests/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="NPOI" Version="2.7.1" />
    <!-- QRCoder — server-side QR rendering for the FBR Digital Invoicing
         block. Previously the template loaded quickchart.io over HTTP per
         print, which leaked the IRN, depended on egress, and broke under
         a strict CSP. PngByteQRCode keeps the produced PNG self-contained
         and inlines as base64 in the print DTO. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <!-- Observability stack — see AUDIT_2026_05_08_OBSERVABILITY.md C-1, H-1, H-2.
         Serilog gives us durable rolling-file logs in production (stdout was
         disappearing on container restart). Microsoft.Extensions.Http.Resilience
         is the .NET 8+ recommended Polly wrapper for HttpClientFactory and powers
         the FBR retry / circuit-breaker / timeout policies. -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
  </ItemGroup>

</Project>
