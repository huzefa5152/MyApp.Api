<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Offline harness, never part of the app build (MyApp.Api.csproj removes
         scripts/**/*.cs). Links the REAL compression middleware and keep-warm
         origin rule; this line has no xUnit project. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Middleware\ApiCompressionMiddleware.cs" />
    <Compile Include="..\..\Services\HostedServices\KeepWarmService.cs" />
  </ItemGroup>
</Project>
