<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- READ-ONLY reader used by the reconcile-stock-sheet skill. References the
         BUILT app (bin/Debug/net9.0/MyApp.Api.dll) so it runs the shipped FIFO
         walk. SELECT only. Build the app first: dotnet build MyApp.Api.csproj. -->
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
    <Reference Include="MyApp.Api">
      <HintPath>..\..\bin\Debug\net9.0\MyApp.Api.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
