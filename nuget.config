<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Audit H-8: vendored non-public packages (UglyToad.PdfPig 1.7.0-custom-5).
         A repo-local folder feed so a clean CI restore is reproducible without
         reaching an external custom feed. nuget.org cannot supply -custom-5. -->
    <add key="local-vendor" value="./nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
